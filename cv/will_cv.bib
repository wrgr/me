keywords={Automated segmentation,Cell counting,Electron microscopy,Neocortex,Neuroanatomy,X-ray Microtomography},
mendeley-groups={{\_}{\_}mod14,willtoadd},
number={5},
title={{Quantifying mesoscale neuroanatomy using X-ray microtomography}},
volume={4},
year={2017}
}


